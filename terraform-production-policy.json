{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "TerraformEC2Read",
      "Effect": "Allow",
      "Action": [
        "ec2:DescribeVpcs",
        "ec2:DescribeSubnets",
        "ec2:DescribeSecurityGroups",
        "ec2:DescribeInstances",
        "ec2:DescribeVpcAttribute",
        "ec2:DescribeSecurityGroupRules",
        "ec2:DescribeInternetGateways",
        "ec2:DescribeRouteTables",
        "ec2:AssociateRouteTable"
      ],
      "Resource": "*"
    },
    {
      "Sid": "TerraformNetwork",
      "Effect": "Allow",
      "Action": [
        "ec2:CreateVpc",
        "ec2:DeleteVpc",
        "ec2:CreateSubnet",
        "ec2:DeleteSubnet",
        "ec2:CreateRouteTable",
        "ec2:DeleteRouteTable",
        "ec2:CreateRoute",
        "ec2:DeleteRoute",
        "ec2:CreateInternetGateway",
        "ec2:AttachInternetGateway",
        "ec2:DetachInternetGateway",
        "ec2:DeleteInternetGateway"
      ],
      "Resource": "*"
    },
    {
      "Sid": "TerraformSecurityGroups",
      "Effect": "Allow",
      "Action": [
        "ec2:CreateSecurityGroup",
        "ec2:DeleteSecurityGroup",
        "ec2:AuthorizeSecurityGroupIngress",
        "ec2:AuthorizeSecurityGroupEgress",
        "ec2:RevokeSecurityGroupIngress",
        "ec2:RevokeSecurityGroupEgress"
      ],
      "Resource": "*"
    },
    {
      "Sid": "TerraformCompute",
      "Effect": "Allow",
      "Action": [
        "ec2:RunInstances",
        "ec2:TerminateInstances",
        "ec2:CreateTags",
        "ec2:DeleteTags"
      ],
      "Resource": "*"
    },

    {
      "Sid": "CreateFlowLogKmsKey",
      "Effect": "Allow",
      "Action": "kms:CreateKey",
      "Resource": "*"
    },

    {
      "Sid": "ManageFlowLogKmsKey",
      "Effect": "Allow",
      "Action": [
        "kms:PutKeyPolicy",
        "kms:DescribeKey",
        "kms:GetKeyPolicy",
        "kms:EnableKeyRotation",
        "kms:GetKeyRotationStatus"
      ],
      "Resource": "arn:aws:kms:us-east-1:000624196441:key/*"
     },

    {
      "Sid": "CreateFlowLogRole",
      "Effect": "Allow",
      "Action": [
        "iam:CreateRole",
        "iam:GetRole",
        "iam:ListRolePolicies"
      ],
      "Resource": "arn:aws:iam::000624196441:role/vpc-flow-log-role"
    },

    {
  "Sid": "ManageLabFlowLogs",
  "Effect": "Allow",
  "Action": [
    "ec2:CreateFlowLogs",
    "ec2:DescribeFlowLogs",
    "ec2:DeleteFlowLogs"
  ],
  "Resource": "*"
},
{
  "Sid": "ManageLabLogGroup",
  "Effect": "Allow",
  "Action": [
    "logs:CreateLogGroup",
    "logs:DescribeLogGroups",
    "logs:DeleteLogGroup",
    "logs:PutRetentionPolicy",
    "logs:DescribeLogStreams"
  ],
  "Resource": "*"
},
{
  "Sid": "ManageLabLogGroupEncryption",
  "Effect": "Allow",
  "Action": [
    "logs:AssociateKmsKey",
    "logs:DisassociateKmsKey"
  ],
  "Resource": "arn:aws:logs:us-east-1:000624196441:log-group:/aws/vpc/flow-logs"
},
{
  "Sid": "ManageLabRoles",
  "Effect": "Allow",
  "Action": [
    "iam:CreateRole",
    "iam:GetRole",
    "iam:DeleteRole",
    "iam:PutRolePolicy",
    "iam:GetRolePolicy",
    "iam:DeleteRolePolicy"
  ],
  "Resource": [
    "arn:aws:iam::000624196441:role/vpc-flow-log-role",
    "arn:aws:iam::000624196441:role/production-web-role"
  ]
},
{
  "Sid": "ManageLabInstanceProfile",
  "Effect": "Allow",
  "Action": [
    "iam:CreateInstanceProfile",
    "iam:GetInstanceProfile",
    "iam:DeleteInstanceProfile",
    "iam:AddRoleToInstanceProfile",
    "iam:RemoveRoleFromInstanceProfile"
  ],
  "Resource": "arn:aws:iam::000624196441:instance-profile/production-web-profile"
},
{
  "Sid": "PassLabRoles",
  "Effect": "Allow",
  "Action": "iam:PassRole",
  "Resource": [
    "arn:aws:iam::000624196441:role/vpc-flow-log-role",
    "arn:aws:iam::000624196441:role/production-web-role"
  ]
}
  ]
}
